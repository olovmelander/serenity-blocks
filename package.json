{
  "name": "serenity-blocks",
  "version": "1.0.0",
  "description": "A modern Tetris-inspired puzzle game built with Phaser 4",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "dev:electron": "NODE_ENV=development electron electron/main.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "audit:theme-lifecycle": "node scripts/theme-lifecycle-audit.mjs",
    "check:release-gates": "node scripts/release-gate-check.mjs",
    "build:gpu-launcher": "bash scripts/build-gpu-launcher.sh",
    "validate:cosmic-noir:phase6": "env -u ELECTRON_RUN_AS_NODE npx electron scripts/cosmic-noir-phase6-validation.mjs",
    "validate:wolfhour:phase6": "env -u ELECTRON_RUN_AS_NODE npx electron scripts/wolfhour-phase6-validation.mjs",
    "build:win": "vite build && electron-builder --win --x64",
    "build:linux": "vite build && electron-builder --linux",
    "capture:themes": "npx electron scripts/capture-theme-screenshots.mjs"
  },
  "build": {
    "appId": "com.serenityblocks.game",
    "productName": "Serenity Blocks",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/steamworks.js/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "extraFiles": [
      {
        "from": "steam_appid.txt",
        "to": "."
      }
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "keywords": [
    "tetris",
    "puzzle",
    "game",
    "phaser",
    "phaser4"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ez-steam-api": "^0.57.1",
    "phaser": "4.0.0-rc.6",
    "steamworks.js": "^0.4.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "node-fetch": "^3.3.2",
    "electron": "^38.3.0",
    "electron-builder": "^26.4.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  }
}
