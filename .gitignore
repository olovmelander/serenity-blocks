# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local
.venv

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# OS files
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/
# Throwaway Electron profile dirs from run-electron / capture / perf tooling
.tmp-electron*/

Andromeda/
three_js_example_repo/
synthcity1/
demo-2023-rain-puddle/
quadra/
release/


# Secrets
google-credentials.json

# Validation/screenshot artifacts
artifacts/

# Repository cleanup: generated or local-only outputs
/.vite/
/theme-screenshots/
/assets/
/docs/validation/
debug_output.txt
test_output*.txt

# Playground / capture artifacts (local-only screenshot outputs)
/.playground-shots/
/playground_*_current.png
/docs/_captures/
/docs/perf-captures/

# Browser diagnostics and draft boot captures stay local. Runtime PNG assets
# remain versioned, as do existing tracked reports and the curated proofs below.
/.playwright-mcp/
/reports/boot-smoothness/*.png
/reports/boot-smoothness/*.json
/reports/playground/*.png
/reports/playground/*.json
/reports/boot-aurora/*.png
!/reports/boot-aurora/continuous-light-prototype.png
!/reports/boot-aurora/wordmark-brand-proof.png
!/reports/boot-aurora/tagline-loading-mobile.png
!/reports/boot-aurora/tagline-dots-title.png
!/reports/boot-aurora/tagline-dots-menu-desktop.png
!/reports/boot-aurora/tagline-dots-menu-mobile.png

# Odyssey GLB optimize backups (rollback source is git HEAD; never commit the uncompressed originals)
src/rendering/odyssey/assets/_originals/

# Python bytecode caches (never commit)
__pycache__/
*.pyc

# Blender autosave copies and report-local tool diagnostics are generated outputs.
*.blend[0-9]*
/reports/**/chrome-tools.json
/reports/**/failed-page.html
/reports/**/failed-capture.png
